        <skos:prefLabel xml:lang="ro">Terminologia specifică înmulțirii</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C36_3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C36_3">
