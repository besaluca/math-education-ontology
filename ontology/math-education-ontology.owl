    <!-- https://w3id.org/math-education-ontology#C3_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C3_1">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C3"/>
        <skos:definition xml:lang="ro">Gruparea cifrelor unui număr în clase de câte trei cifre, începând de la dreapta spre stânga.</skos:definition>
        <skos:prefLabel xml:lang="ro">Clasele numerelor</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C3_2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C3_2">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C3"/>
        <skos:definition xml:lang="ro">Denumirile asociate grupelor de câte trei cifre, precum clasa unităților, miilor, milioanelor și miliardelor.</skos:definition>
        <skos:prefLabel xml:lang="ro">Denumirea claselor numerice</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C4">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:definition xml:lang="ro">Reprezentarea unui număr natural prin cuvinte în locul notației cu cifre.</skos:definition>
        <skos:prefLabel xml:lang="ro">Reprezentarea textuală a numerelor naturale</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C40 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C40">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <math-education-ontology:hasPrerequisite rdf:resource="https://w3id.org/math-education-ontology#C36"/>
        <skos:definition xml:lang="ro">Proprietatea numărului 1 în cadrul operației de înmulțire.</skos:definition>
        <skos:prefLabel xml:lang="ro">Elementul neutru al înmulțirii</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C40_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C40_1">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C40"/>
        <skos:definition xml:lang="ro">Recunoașterea faptului că numărul 1 nu schimbă valoarea factorului: a * 1 = 1 * a = a.</skos:definition>
        <skos:prefLabel xml:lang="ro">Anularea produsului prin înmulțire cu zero</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C41 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C41">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <math-education-ontology:hasPrerequisite rdf:resource="https://w3id.org/math-education-ontology#C36"/>
        <skos:definition xml:lang="ro">Proprietatea de absorbție (anulare) a numărului 0 în operația de înmulțire.</skos:definition>
        <skos:prefLabel xml:lang="ro">Rolul numărului 0 la înmulțire</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C41_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C41_1">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C41"/>
        <skos:definition xml:lang="ro">Orice număr înmulțit cu 0 dă 0, prin exemplificare, a*0 = 0*a = 0</skos:definition>
        <skos:prefLabel xml:lang="ro">Anularea produsului prin înmulțire cu zero</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C41_2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C41_2">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C41"/>
        <math-education-ontology:hasPrerequisite rdf:resource="https://w3id.org/math-education-ontology#C40_1"/>
        <skos:definition xml:lang="ro">Dacă un produs este egal cu 0 (a * b = 0), atunci cel puțin unul dintre factori este obligatoriu 0 (a=0 sau b=0).</skos:definition>
        <skos:prefLabel xml:lang="ro">Deducerea factorului nul</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C42 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C42">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <math-education-ontology:hasPrerequisite rdf:resource="https://w3id.org/math-education-ontology#C26"/>
        <skos:definition xml:lang="ro">Relația algebrică prin care înmulțirea se distribuie peste adunare și scădere.</skos:definition>
        <skos:prefLabel xml:lang="ro">Distributivitatea înmulțirii</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C42_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C42_1">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C42"/>
        <skos:definition xml:lang="ro">Înțelegerea și aplicarea egalității a * (b+c) = a * b + a * c</skos:definition>
        <skos:prefLabel xml:lang="ro">Distributivitatea față de adunare</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C42_2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C42_2">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C42"/>
        <math-education-ontology:hasPrerequisite rdf:resource="https://w3id.org/math-education-ontology#C30"/>
        <skos:definition xml:lang="ro">Înțelegerea și aplicarea egalității a*(b-c) = a*b - a*c</skos:definition>
        <skos:prefLabel xml:lang="ro">Distributivitatea față de scădere</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C42_3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C42_3">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C42"/>
        <math-education-ontology:hasPrerequisite rdf:resource="https://w3id.org/math-education-ontology#C42_1"/>
        <skos:definition xml:lang="ro">Utilizarea distributivității pentru a rezolva mintal înmulțiri complexe</skos:definition>
        <skos:prefLabel xml:lang="ro">Distributivitatea în ecuații</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C43 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C43">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <math-education-ontology:hasPrerequisite rdf:resource="https://w3id.org/math-education-ontology#C27"/>
        <math-education-ontology:hasPrerequisite rdf:resource="https://w3id.org/math-education-ontology#C34"/>
        <skos:definition xml:lang="ro">Regulile de păstrare a valorii de adevăr atunci când se înmulțesc membrii unei relații matematice.</skos:definition>
        <skos:prefLabel xml:lang="ro">Relațiile de egalitate și inegalitate la înmulțire</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C43_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C43_1">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C43"/>
        <skos:definition xml:lang="ro">Având o egalitate dată, a = b, înmulțind cu un număr natural c, vom obține 
a*c = b*c, oricare a,b,c, numere naturale.</skos:definition>
        <skos:prefLabel xml:lang="ro">Înmulțirea egalităților cu o constantă</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C43_2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C43_2">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C43"/>
        <skos:definition xml:lang="ro">Având o egalitate dată, a &lt; b, înmulțind cu un număr natural c, vom obține 
a*c &lt; b*c, oricare a,b,c, numere naturale.</skos:definition>
        <skos:prefLabel xml:lang="ro">Înmulțirea inegalităților cu o constantă nenulă</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C43_3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C43_3">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C43"/>
        <skos:definition xml:lang="ro">Dacă a = b și c = d, atunci a * c &lt; b * d, pentru oricare a,b,c,d, numere naturale nenule</skos:definition>
        <skos:prefLabel xml:lang="ro">Înmulțirea membru cu membru (egalități)</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C43_4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C43_4">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C43"/>
        <skos:definition xml:lang="ro">Dacă a &lt; b și c &lt; d, atunci a * c &lt; b * d, pentru oricare a,b,c,d, numere naturale nenule</skos:definition>
        <skos:prefLabel xml:lang="ro">Înmulțirea membru cu membru (inegalități)</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C44 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C44">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:definition xml:lang="ro">Analiza caracteristicii par/impar a rezultatului unei înmulțiri în funcție de factorii săi.</skos:definition>
        <skos:prefLabel xml:lang="ro">Paritatea produsului</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C44_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C44_1">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C44"/>
        <skos:definition xml:lang="ro">Înțelegerea faptului că este suficient ca un singur factor dintr-o înmulțire să fie par pentru ca rezultatul final să fie obligatoriu par.</skos:definition>
        <skos:prefLabel xml:lang="ro">Regula produsului par</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C44_2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C44_2">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C44"/>
        <skos:definition xml:lang="ro">Înțelegerea faptului că un produs este impar dacă, și numai dacă, absolut toți factorii săi sunt numere impare.</skos:definition>
        <skos:prefLabel xml:lang="ro">Regula produsului impar</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C44_3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C44_3">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C44"/>
        <skos:definition xml:lang="ro">Deducerea logică a faptului că înmulțirea a două numere naturale consecutive (n și n+1) generează mereu un număr par (deoarece unul dintre ele este garantat par).</skos:definition>
        <skos:prefLabel xml:lang="ro">Produsul a două numere consecutive</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C45 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C45">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:definition xml:lang="ro">Metode de deducere a cifrei unităților pentru un produs de numere.</skos:definition>
        <skos:prefLabel xml:lang="ro">Analiza ultimei cifre a produsului</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C45_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C45_1">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C45"/>
        <skos:definition xml:lang="ro">Ultima cifră a unui produs mare se obține calculând doar produsul ultimelor cifre ale fiecărui factor.</skos:definition>
        <skos:prefLabel xml:lang="ro">Regula de bază a ultimei cifre</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C45_2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C45_2">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C45"/>
        <skos:definition xml:lang="ro">Dacă cel puțin un factor are ultima cifră 0, produsul va avea ultima cifră 0.</skos:definition>
        <skos:prefLabel xml:lang="ro">Înmulțirea cu factori terminați în 0</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C45_3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C45_3">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C45"/>
        <skos:definition xml:lang="ro">Dacă înmulțim un număr terminat în cifra 5 cu cel puțin un număr par, ultima cifră a produsului este garantat 0</skos:definition>
        <skos:prefLabel xml:lang="ro">Factorul 5 și factorii pari</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C45_4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C45_4">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C45"/>
        <skos:definition xml:lang="ro">Dacă înmulțim un număr terminat în cifra 5 doar cu numere impare, ultima cifră a produsului este garantat 5.</skos:definition>
        <skos:prefLabel xml:lang="ro">Factorul 5 și factorii exclusiv impari</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C45_5 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C45_5">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C45"/>
        <skos:definition xml:lang="ro">Produsul oricăror numere terminate în 1 se va termina în 1; produsul oricăror numere terminate în 6 se va termina în 6.</skos:definition>
        <skos:prefLabel xml:lang="ro">Stabilitatea cifrelor 1 și 6</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C45_6 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C45_6">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C45"/>
        <skos:definition xml:lang="ro">Când calculăm un produs lung, numărul de zerouri de la sfârșit este dat de câte perechi de factori 2 și 5 se pot forma din descompunerea numerelor.</skos:definition>
        <skos:prefLabel xml:lang="ro">Determinarea numărului de zerouri terminale</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C46 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C46">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <math-education-ontology:hasPrerequisite rdf:resource="https://w3id.org/math-education-ontology#C36"/>
        <skos:definition xml:lang="ro">Definiția produsului primelor $n$ numere naturale nenule și studiul resturilor/zerourilor acestuia.</skos:definition>
        <skos:prefLabel xml:lang="ro">Factorialul unui număr natural</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C46_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C46_1">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C46"/>
        <skos:definition xml:lang="ro">Înțelegerea faptului că n! este o scriere prescurtată pentru înmulțirea tuturor numerelor de la 1 la n.</skos:definition>
        <skos:prefLabel xml:lang="ro">Definiția factorialului</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C46_2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C46_2">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C46"/>
        <skos:definition xml:lang="ro">Memorarea regulii stricte conform căreia 0! este egal cu 1.</skos:definition>
        <skos:prefLabel xml:lang="ro">Convenția pentru 0</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C46_3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C46_3">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C46"/>
        <skos:definition xml:lang="ro">Deducerea faptului că pentru orice n &gt;= 5, n! se termină în cifra 0 (pentru că produsul va include mereu factorii 2 și 5).</skos:definition>
        <skos:prefLabel xml:lang="ro">Ultima cifră a factorialului</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C46_4 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C46_4">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C46"/>
        <skos:definition xml:lang="ro">Calcularea numărului de zerouri terminale pentru n! numărând de câte ori apare factorul 5 în numerele din acel șir.</skos:definition>
        <skos:prefLabel xml:lang="ro">Determinarea zerourilor unui factorial</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C4_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C4_1">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C4"/>
        <skos:definition xml:lang="ro">Asocierea dintre reprezentarea cu cifre a unui număr și forma sa scrisă cu litere.</skos:definition>
        <skos:prefLabel xml:lang="ro">Corespondența dintre reprezentarea numerică și cea textuală</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C5 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C5">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:definition xml:lang="ro">Transformarea unui număr exprimat prin cuvinte în reprezentarea sa standard cu cifre arabe.</skos:definition>
        <skos:prefLabel xml:lang="ro">Conversia reprezentării textuale în reprezentare numerică</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C5_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C5_1">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C5"/>
        <skos:definition xml:lang="ro">Rolul cifrei zero în marcarea unui ordin de mărime care nu conține unități în reprezentarea unui număr.</skos:definition>
        <skos:prefLabel xml:lang="ro">&quot;Zero ca marcator al ordinelor lipsă</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C6 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C6">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:definition xml:lang="ro">Caracteristicile unui număr determinate de cifrele care îl compun și de pozițiile ocupate de acestea.</skos:definition>
        <skos:prefLabel xml:lang="ro">Proprietățile structurale ale scrierii numerelor</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C6_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C6_1">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C6"/>
        <skos:definition xml:lang="ro">Condiții privind prezența, identitatea sau poziția unei cifre în scrierea unui număr natural.</skos:definition>
        <skos:prefLabel xml:lang="ro">Criterii structurale asupra cifrelor</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C7 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C7">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:definition xml:lang="ro">Reprezentarea unui număr natural ca sumă a produselor dintre cifrele sale și valorile poziționale corespunzătoare.</skos:definition>
        <skos:prefLabel xml:lang="ro">Descompunerea în baza 10</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C7_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C7_1">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C7"/>
        <skos:definition xml:lang="ro">Scrierea unui număr ca sumă a valorilor corespunzătoare cifrelor sale pe fiecare ordin al sistemului zecimal.</skos:definition>
        <skos:prefLabel xml:lang="ro">Forma descompusă a numerelor naturale</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C7_2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C7_2">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C7"/>
        <skos:definition xml:lang="ro">Reprezentarea numerelor de două sau mai multe cifre prin litere care substituie cifrele componente, de exemplu a·10+b sau a·100+b·10+c.</skos:definition>
        <skos:prefLabel xml:lang="ro">Reprezentarea literală a numerelor</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C8 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C8">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:definition xml:lang="ro">Formarea reprezentării compacte a unui număr natural pornind de la valorile corespunzătoare ordinelor sale.</skos:definition>
        <skos:prefLabel xml:lang="ro">Reconstituirea numerelor din forma descompusă</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C9 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C9">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:definition xml:lang="ro">Principiul conform căruia egalitatea a două reprezentări ale aceluiași număr permite determinarea cifrelor necunoscute prin compararea pozițiilor corespunzătoare.</skos:definition>
        <skos:prefLabel xml:lang="ro">Egalitatea reprezentărilor numerice</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/math-education-ontology#C9_1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/math-education-ontology#C9_1">
        <rdf:type rdf:resource="https://w3id.org/math-education-ontology#MathematicalConcept"/>
        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C9"/>
        <skos:definition xml:lang="ro">Principiul conform căruia două numere sunt egale atunci când cifrele aflate pe poziții corespunzătoare au aceleași valori.</skos:definition>
        <skos:prefLabel xml:lang="ro">Corespondența cifrelor pe poziții</skos:prefLabel>
    </owl:NamedIndividual>
    


