        <skos:broader rdf:resource="https://w3id.org/math-education-ontology#C36"/>
        <skos:definition xml:lang="ro">Diferențierea expresiei matematice a înmulțirii de rezultatul ei</skos:definition>
        <skos:prefLabel xml:lang="ro">Diferenta dintre Produs efectuat si neefectuat</skos:prefLabel>
    </owl:NamedIndividual>
    


